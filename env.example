# Copy to .env (or set these in your host's dashboard) to override the defaults.
# Every value is optional: the defaults are the values found in the original projects.
# Remember: VITE_* values are compiled into the public JS bundle. Never put secret keys here.

# --- Paystack (public keys only) ---
# data bundles + wallet top-ups (live key by default)
VITE_PAYSTACK_PUBLIC_KEY=
# results checkers (test key by default)
VITE_RESULTS_PAYSTACK_KEY=

# --- Backends ---
# bundle catalogue + payment confirmations
VITE_DATA_SUPABASE_URL=
VITE_DATA_SUPABASE_ANON_KEY=
# sign-in, profiles, wallet, account orders
VITE_ACCOUNTS_SUPABASE_URL=
VITE_ACCOUNTS_SUPABASE_ANON_KEY=

# --- Activepieces / Make webhooks ---
# POST {phoneNumber, networkCode} -> {status, name}
VITE_OWNER_LOOKUP_URL=
# POST {type:'reference', reference} -> {orders:[...]}
VITE_ORDER_LOOKUP_URL=
# POST wallet purchase (leave unset to hide wallet payment)
VITE_WALLET_PURCHASE_URL=
# POST {reference, product_id, quantity} -> {pins:[{pin,serial}]}
VITE_RESULTS_VERIFY_URL=
# admin data transfer webhook (leave unset to disable /admin/transfer)
VITE_DATA_TRANSFER_URL=

# --- Contact ---
# international format, no plus sign
VITE_WHATSAPP_NUMBER=233540753328
VITE_SUPPORT_EMAIL=support@sci-fidata.com
